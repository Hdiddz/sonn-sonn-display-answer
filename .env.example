# API key DeepSeek — dapatkan di https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_key_here

# Opsional: ganti model (default: deepseek-flash)
# DEEPSEEK_MODEL=deepseek-flash

# Opsional: endpoint apa pun yang kompatibel OpenAI dan menerima gambar
# serta JSON mode. Kosongkan untuk memakai DeepSeek. Thinking dan pencarian
# web hanya berjalan di endpoint DeepSeek.
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Opsional: pencarian web untuk jawaban yang butuh fakta terkini
# (default: on). Set off untuk menjawab dari tangkapan layar saja.
# DEEPSEEK_SEARCH=on
