# DeepSeek API key — get yours from https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_key_here

# Optional: override the model (default: deepseek-flash)
# DEEPSEEK_MODEL=deepseek-flash

# Optional: any OpenAI-compatible endpoint that accepts images and JSON mode.
# Leave unset for DeepSeek. Web grounding only runs on the DeepSeek endpoint.
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: live web grounding for answers about current facts
# (default: on). Set to off to answer from the screenshot alone.
# DEEPSEEK_SEARCH=on
